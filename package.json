{
  "name": "leion-workspace",
  "version": "0.1.0",
  "description": "Tiling window manager for Leion development environment",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron": "electron .",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "leion",
    "workspace",
    "electron",
    "tiling"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@google/genai": "^1.41.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/dagre": "^0.7.53",
    "@types/uuid": "^10.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "emoji-picker-react": "^4.18.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.563.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-mosaic-component": "^6.1.0",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "zundo": "^2.3.0",
    "zustand": "^4.4.0"
  }
}
